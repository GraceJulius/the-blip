# Copy to .env.local. Never commit real keys.
# Optional: enables Nemotron for gray-area scam messages. Without it the app uses rules only.
NVIDIA_API_KEY=
# Model name copied from the build.nvidia.com code sample.
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# Only change if you host Nemotron yourself (for example on Brev).
NEMOTRON_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Password for the Reset demo data button. Required on the live server; reset is disabled without it.
ADMIN_PASSWORD=
# Most model calls allowed per 10 minutes across all visitors. Beyond this the app uses rules only.
MODEL_CALLS_PER_10MIN=60

# Optional: a Postgres connection string. When set, the app saves its state there and reloads it on start,
# so data survives redeploys. Leave empty to keep data in memory and a local file.
DATABASE_URL=
# Most students the demo will hold before it refuses new ones.
MAX_STUDENTS=5000

# Claude (Anthropic) reads grocery requests and writes short advice. Optional: without it, a keyword matcher and plain text are used.
ANTHROPIC_API_KEY=
# Model to use. Defaults to claude-opus-5. Pick a cheaper model here to stretch your credits.
CLAUDE_MODEL=
# Most Claude calls allowed per 10 minutes across all visitors.
CLAUDE_CALLS_PER_10MIN=40

# Local testing only. Never set these on a live server: they let webhooks call local and http addresses.
WEBHOOK_ALLOW_INSECURE=
WEBHOOK_ALLOW_PRIVATE=

# Read aloud (optional). Without a key the browser's own voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
ELEVENLABS_CALLS_PER_10MIN=
