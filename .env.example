# Copy to .env.local. Never commit real keys.
# Optional: enables Nemotron for gray-area scam messages. Without it the app uses rules only.
NVIDIA_API_KEY=
# Check the exact model name on build.nvidia.com before the event, then set it here.
NEMOTRON_MODEL=
# Only change if you host Nemotron yourself (for example on Brev).
NEMOTRON_URL=https://integrate.api.nvidia.com/v1/chat/completions
